# Copy to .env and fill in values. Do not commit .env.

GOOGLE_API_KEY=
# or: GEMINI_API_KEY=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-research-assistant

TAVILY_API_KEY=

# Full model id (e.g. gemini-2.5-flash). "gemini-2.5" alone is invalid.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Chat LLM retries on failure (429/quota retries add delay; default 1 = one retry)
GEMINI_MAX_RETRIES=1

MAX_UPLOAD_FILES=5
MAX_PAGES_PER_FILE=10
RETRIEVAL_K=5
# Wider candidate pool for cross-encoder rerank (final count stays RETRIEVAL_K)
RETRIEVAL_FETCH_MULTIPLIER=4
# Rerank with FlashRank (local); set false to use vector similarity only
USE_RERANK=true
USE_MULTI_QUERY=false

CHUNK_SIZE=1200
CHUNK_OVERLAP=180

AGENT_MAX_ITERATIONS=5
